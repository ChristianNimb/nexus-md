{
  "name": "nexus-md",
  "version": "0.1.0",
  "description": "A lightweight, multi-functional WhatsApp bot framework written in TypeScript.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:web": "node src/web/build.mjs",
    "dev:web": "node src/web/build.mjs --watch"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "typescript"
  ],
  "author": "ChristianNimb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianNimb/nexus-md.git"
  },
  "bugs": {
    "url": "https://github.com/ChristianNimb/nexus-md/issues"
  },
  "homepage": "https://github.com/ChristianNimb/nexus-md#readme",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@hapi/boom": "^10.0.1",
    "@nexus21/nexus-api": "1.1.10",
    "@napi-rs/canvas": "^0.1.65",
    "audio-decode": "^2.2.3",
    "axios": "^1.7.7",
    "baileys": "^6.7.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "qrcode-terminal": "^0.12.0",
    "youtube-sr": "^4.3.11"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}

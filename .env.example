# ---- Nexus-MD configuration ----
# Copy this file to `.env` and edit values.

# Command prefix(es). Each character is treated as a valid prefix.
# Example: ".!/" allows .ping, !ping, /ping
PREFIX=.

# Bot operating mode:
#   public  -> anyone can use non-owner commands
#   private -> only the owner/sudo can use the bot
MODE=public

# Comma-separated list of owner numbers (with country code, no +), e.g. 15551234567,447700900000
# The linked account is always treated as owner.
OWNERS=

# Friendly name shown in menus / alive message
BOT_NAME=Nexus-MD

# Default timezone (IANA name) used when a person's zone can't be inferred from
# their phone number. Nexus auto-detects most users by country/area code, and
# anyone can override theirs with the .tz command. Example: America/Chicago (CST)
BOT_TZ=America/Chicago

# Folder where the WhatsApp auth/session is stored (relative to project root)
SESSION_DIR=session

# SQLite database file
DB_PATH=nexus.db

# Log level: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# ---- Nexus AI assistant (.nexus command) ----
# Works with any OpenAI-compatible provider (Groq, OpenRouter, OpenAI, local...)
# or the Anthropic Claude API. Leave the key blank to disable .nexus.
#
# RECOMMENDED (free): Groq — get a free key at https://console.groq.com/keys
NEXUS_API_KEY=
NEXUS_API_URL=https://api.groq.com/openai/v1/chat/completions
NEXUS_MODEL=llama-3.3-70b-versatile
#
# ---- FULLY LOCAL (no rate limits) via Ollama + a GPU (e.g. RTX 4060) ----
# Install Ollama (https://ollama.com), then:
#   ollama pull qwen3:8b            # chat brain (~5GB VRAM)
#   ollama pull qwen2.5vl:7b        # vision — "sees" images/videos
# Then set these (host.docker.internal lets the container reach Ollama on the host):
#   NEXUS_API_URL=http://host.docker.internal:11434/v1/chat/completions
#   NEXUS_API_KEY=ollama            # dummy; Ollama ignores it
#   NEXUS_MODEL=qwen3:8b
#   NEXUS_VISION_MODEL=qwen2.5vl:7b
# Optional safety net: if your GPU box is ever off/unreachable, auto-fail-over to
# Groq so the bot never goes silent (put your Groq key here):
#   NEXUS_FALLBACK_URL=https://api.groq.com/openai/v1/chat/completions
#   NEXUS_FALLBACK_KEY=gsk_your_groq_key
#   NEXUS_FALLBACK_MODEL=llama-3.3-70b-versatile
#   NEXUS_VISION_FALLBACK_MODEL=qwen/qwen3.6-27b  # vision failover (Groq's current multimodal model)
#
# Expressive local voice (Higgs / Qwen3-TTS) with style-by-description
# ("soft, romantic, whispering"). Run docker/tts-server/server.py on your GPU box:
#   NEXUS_TTS_LOCAL_URL=http://host.docker.internal:8020/
# It's the top voice engine when set; falls back to Edge/Piper if unreachable.
# Search stays free (DuckDuckGo), images free (Pollinations), voice free (Piper/Edge)
# — so a fully-local bot has NO rate limits and NO API costs anywhere.
# Optional: a VISION model (same provider) to "look at" and caption stickers
# Nexus collects + read images. Leave blank to just collect random real stickers.
# Groq example (qwen/qwen3.6-27b — Groq's current multimodal model; Llama 4 Scout
# was deprecated & decommissioned on 2026-07-17):
NEXUS_VISION_MODEL=qwen/qwen3.6-27b

# Code-specialist model for .code (developer mode). Groq's best coders are
# openai/gpt-oss-120b (default, stable) or qwen/qwen3-32b (preview).
NEXUS_CODE_MODEL=openai/gpt-oss-120b

# ---- Voice: Nexus can hear and speak ----
# HEARING (speech-to-text): free on Groq. Send Nexus a voice note during an
# active chat (start with a text "nexus ...") and it transcribes + replies.
NEXUS_STT_MODEL=whisper-large-v3
# SPEAKING (text-to-speech): works FREE with no key.
# Primary engine is Microsoft Edge Neural TTS (very natural, free, needs
# internet). If it's ever unreachable, Nexus falls back to Piper — a local,
# offline neural voice baked into the image (robotic but always works).
NEXUS_TTS_EDGE=on
#
# These are set automatically by the Dockerfile; only change them to swap voice:
#   PIPER_BIN=/opt/piper/piper
#   PIPER_VOICE=/opt/piper-voices/voice.onnx
# (Download other voices from https://huggingface.co/rhasspy/piper-voices)
#
# Web fallback (only used if Piper is missing, e.g. running outside Docker):
# StreamElements / Google, no key. Voices: Brian, Amy, Emma, Joanna, Matthew...
NEXUS_TTS_FREE=on
NEXUS_TTS_FREE_VOICE=Brian
#
# OPTIONAL paid upgrade — Groq Orpheus (needs billing + terms acceptance).
# Leave blank to stay 100% free. If set, it's tried first, then falls back.
NEXUS_TTS_MODEL=
NEXUS_TTS_VOICE=daniel
#
# Examples for other providers:
#   OpenRouter: NEXUS_API_URL=https://openrouter.ai/api/v1/chat/completions
#   OpenAI:     NEXUS_API_URL=https://api.openai.com/v1/chat/completions ; NEXUS_MODEL=gpt-4o-mini
#   Claude:     NEXUS_API_URL=https://api.anthropic.com/v1/messages ; NEXUS_MODEL=claude-3-5-haiku-latest (needs Anthropic credits)

# ---- Coding agent (.code — Nexus edits its OWN code, owner-only, with approval) ----
# A SEPARATE, strong coding model (Claude / GPT-4 class recommended). Leave the
# key blank to disable the .code feature. From mainland China these APIs are
# blocked, so set NEXUS_PROXY (above) too.
#   Claude:  NEXUS_CODER_URL=https://api.anthropic.com/v1/messages ; NEXUS_CODER_MODEL=claude-sonnet-5
#   OpenAI:  NEXUS_CODER_URL=https://api.openai.com/v1/chat/completions ; NEXUS_CODER_MODEL=gpt-4o
NEXUS_CODER_URL=https://api.anthropic.com/v1/messages
NEXUS_CODER_MODEL=claude-sonnet-5
NEXUS_CODER_KEY=

# ---- Web search (.search + Nexus real-time answers) ----
# Which engine Nexus uses for live web lookups:
#   ddg    -> DuckDuckGo, FREE, no key, does NOT use your Groq quota (default)
#   tavily -> best quality, free tier ~1000/mo, needs TAVILY_API_KEY
#   brave  -> good, free tier ~2000/mo, needs BRAVE_API_KEY
#   groq   -> Groq compound (built-in search) but uses your Groq quota
NEXUS_SEARCH_ENGINE=ddg
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# Only used when NEXUS_SEARCH_ENGINE=groq:
NEXUS_SEARCH_MODEL=groq/compound-mini

# ---- Social-media downloads (.dl / autodl for TikTok, Instagram, X, ...) ----
# URL of a Cobalt API instance (https://github.com/imputnet/cobalt).
# Self-hosting your own is recommended. Leave blank to disable social downloads.
# YouTube (.play/.video/.ytmp3/.ytmp4) works WITHOUT this.
COBALT_API_URL=
# Proxy for downloads — REQUIRED if your server can't reach YouTube/TikTok/IG/X
# directly (e.g. behind the Great Firewall in mainland China). Point it at your
# VPN/Clash/v2ray. From inside Docker use host.docker.internal (NOT localhost),
# because localhost is the container. Examples:
#   NEXUS_PROXY=http://host.docker.internal:7890
#   NEXUS_PROXY=socks5://host.docker.internal:7891
# Leave blank to connect directly.
NEXUS_PROXY=
# Add a Windows environment variable: OLLAMA_KEEP_ALIVE = 30m (or 1h)
# Quit and reopen Ollama.

# ---- Website + browser linking panel (scan the QR in a browser) ----
# Nexus-MD serves a small site with a linking panel, so you can scan the QR or
# get a pairing code in your browser instead of hunting for it in the logs:
#   http://localhost:3000/        the site
#   http://localhost:3000/link    scan the QR / get a pairing code
#
# SET A PASSWORD. Whoever can open the panel can link THEIR phone as this bot's
# account. With this left blank the panel refuses to serve at all, and only the
# public landing page stays up.
NEXUS_WEB_PASSWORD=
# Turn the whole web server off with: NEXUS_WEB=off
NEXUS_WEB=on
NEXUS_WEB_PORT=3000
# Bind address. 0.0.0.0 is required inside Docker for the published port to be
# reachable from your host (and from your phone on the same wifi). Use
# 127.0.0.1 only when running the bot directly on your machine without Docker.
NEXUS_WEB_HOST=0.0.0.0

# Where the managed hosting dashboard lives, for the landing page's
# "Deploy on Nexus Hosting" button. Leave blank when self-hosting: this server
# then explains that the dashboard is not part of this instance, instead of
# returning a bare 404 on its own page.
NEXUS_HOSTING_URL=

# Nexus-MD — copy to .env. Only NEXUS_API_KEY is required.
#
# Every other setting has a working default (see src/config.ts) and is read
# straight from the environment, so you only add a line here to override one.
# The advanced knobs — model choices, voice engines, the .code agent, search,
# proxy, panel host/port, sync timeout — are documented in src/config.ts.

# ---- required ----
# Your AI provider key. Free Groq key: https://console.groq.com/keys
NEXUS_API_KEY=

# ---- your bot ----
BOT_NAME=Nexus-MD
OWNERS=                 # your number(s), country code, no +, comma-separated
SUDO=                   # helper number(s), same format — elevated, but not owners
PREFIX=.
MODE=public             # public | private (owner only)

DISABLE_START_MESSAGE=false   # true = no "connected" card after linking
SEND_READ=on                  # off = never send blue ticks (bot still replies)

# ---- linking ----
# Nexus sends you a SESSION_ID after you link on the pairing site; set it to
# start with no QR. On the hosting platform this is filled in for you.
SESSION_ID=

# Gates the local linking panel, which can reveal a pairing QR. Only needed if
# you self-host and leave the panel on.
NEXUS_WEB_PASSWORD=

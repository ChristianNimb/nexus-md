# Nexus-MD — copy to .env and fill in. Only NEXUS_API_KEY is required.

# ---- basics ----
PREFIX=.
MODE=public                       
OWNERS=                           
BOT_NAME=Nexus-MD
BOT_TZ=America/Chicago            
LOG_LEVEL=info                    
NEXUS_LOG_JSON=                   

# ---- storage ----
SESSION_DIR=session
DB_PATH=nexus.db


SESSION_ID=
NEXUS_SESSION_KEY=                

# ---- AI ----
NEXUS_API_KEY=
NEXUS_API_URL=https://api.groq.com/openai/v1/chat/completions
NEXUS_MODEL=openai/gpt-oss-120b
NEXUS_VISION_MODEL=qwen/qwen3.6-27b
NEXUS_CODE_MODEL=openai/gpt-oss-120b
NEXUS_STT_MODEL=whisper-large-v3 


# ---- voice ----
NEXUS_TTS_EDGE=on                 
NEXUS_TTS_FREE=on                 
NEXUS_TTS_FREE_VOICE=Brian
NEXUS_TTS_MODEL=                  
NEXUS_TTS_VOICE=daniel


# ---- coding agent (.code, owner only) ----
NEXUS_CODER_URL=https://api.anthropic.com/v1/messages
NEXUS_CODER_MODEL=claude-sonnet-5
NEXUS_CODER_KEY=                  

# ---- search ----
NEXUS_SEARCH_ENGINE=ddg           
NEXUS_SEARCH_MODEL=groq/compound-mini


# ---- downloads ----
COBALT_API_URL=                   
NEXUS_PROXY=                      

# ---- web panel ----
NEXUS_WEB_PASSWORD=               # REQUIRED to serve the panel — it reveals QR codes
NEXUS_WEB=on
NEXUS_WEB_PORT=3000
NEXUS_WEB_HOST=0.0.0.0

# How long WhatsApp gets to finish its first sync, in milliseconds.
# Raise it if the log says "init queries Timed Out" and the bot connects but
# answers nobody: a busy account with years of chats needs longer than a fresh
# one, and until the sync finishes WhatsApp delivers it no messages at all.
NEXUS_QUERY_TIMEOUT_MS=90000

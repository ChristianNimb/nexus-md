# ---- required only if yoy deliberately want to enjoy what flavours Nexus comes with----

# Your AI provider key. Free Groq key: https://console.groq.com/keys
NEXUS_API_KEY=
NEXUS_MODEL=
NEXUS_FALLBACK_MODEL=
NEXUS_VISION_MODEL=

# ---- extra fallback providers (so you don't hit usage limits) ----
# The bot tries the primary, then walks these in order on any rate-limit/outage.
# Both use free tiers; set only a key + model, the URL is filled in for you.
# OpenRouter key: https://openrouter.ai/keys   |  Gemini key: https://aistudio.google.com/apikey
OPENROUTER_API_KEY=
OPENROUTER_MODEL=            # e.g. meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=     # e.g. google/gemini-2.0-flash-exp:free  (image understanding)
GEMINI_API_KEY=
GEMINI_MODEL=                # e.g. gemini-2.0-flash
GEMINI_VISION_MODEL=         # e.g. gemini-2.0-flash  (fixes sticker auto-save when Groq 404s vision)
# More slots for any other OpenAI-compatible endpoint (2..5):
# NEXUS_FALLBACK_2_URL=  NEXUS_FALLBACK_2_KEY=  NEXUS_FALLBACK_2_MODEL=


# ---- your bot ----
BOT_NAME=Nexus-MD
OWNERS=                 
SUDO=                   
PREFIX=.
MODE=public             

DISABLE_START_MESSAGE=false   
SEND_READ=on                 


SESSION_ID=

# Gates the local linking panel, which can reveal a pairing QR. Only needed if
# you self-host and leave the panel on.
NEXUS_WEB_PASSWORD=
